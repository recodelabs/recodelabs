{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recodelabs",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "CONTACT_TO": "hello@recodelabs.org",
    "CONTACT_FROM": "Recode Labs website <website@recodelabs.org>"
  }
}
